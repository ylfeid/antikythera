{
  "name": "antikythera",
  "version": "1.0.0",
  "description": "An interactive 3D reconstruction of the Antikythera mechanism in WebGPU, with its astronomy checked against a modern ephemeris.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "accuracy": "node scripts/accuracy.ts"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "webgpu",
    "antikythera",
    "astronomy",
    "ephemeris",
    "gears",
    "history-of-science",
    "wgsl"
  ]
}
